{
    "version": "1.0.0",
    "title": "Chaos Mesh HTTP Patch",
    "description": "Applies an HTTP patch to matching traffic.",
    "configuration": {
        "namespace": "default",
        "mode": "one",
        "selector": {},
        "target": "Request",
        "port": 8080,
        "method": "GET",
        "path": "/",
        "duration": "30s",
        "patch": {
            "headers": {
                "X-ChaosForge": "true"
            }
        }
    },
    "chaos_mesh": {
        "kind": "HTTPChaos",
        "action": "patch"
    }
}
