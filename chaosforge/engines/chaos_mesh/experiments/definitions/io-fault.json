{
    "version": "1.0.0",
    "title": "Chaos Mesh IO Fault",
    "description": "Injects IO faults into selected Kubernetes pods.",
    "configuration": {
        "namespace": "default",
        "mode": "one",
        "selector": {},
        "duration": "30s",
        "volume_path": "/tmp",
        "errno": 5
    },
    "chaos_mesh": {
        "kind": "IOChaos",
        "action": "fault"
    }
}
