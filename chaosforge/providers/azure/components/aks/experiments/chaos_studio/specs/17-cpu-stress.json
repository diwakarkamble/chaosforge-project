{
    "kind": "StressChaos",
    "mode": "one",
    "selector": {
      "namespaces": [
        "<target-namespace>"
      ],
      "labelSelectors": {
        "app": "<app-label>"
      }
    },
    "stressors": {
      "cpu": {
        "workers": 2,
        "load": 80
      }
    },
    "duration": "<duration>"
  }
