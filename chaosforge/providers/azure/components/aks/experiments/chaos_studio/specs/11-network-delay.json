{
  "kind": "NetworkChaos",
  "action": "delay",
  "mode": "one",
  "selector": {
    "namespaces": [
      "<target-namespace>"
    ],
    "labelSelectors": {
      "app": "<app-label>"
    }
  },
  "delay": {
    "latency": "500ms",
    "correlation": "50",
    "jitter": "100ms"
  },
  "duration": "<duration>"
}
