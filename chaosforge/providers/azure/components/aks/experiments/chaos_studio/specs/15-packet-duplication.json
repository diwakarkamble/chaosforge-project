{
  "kind": "NetworkChaos",
  "action": "duplicate",
  "mode": "one",
  "selector": {
    "namespaces": [
      "<target-namespace>"
    ],
    "labelSelectors": {
      "app": "<app-label>"
    }
  },
  "duplicate": {
    "duplicate": "50",
    "correlation": "25"
  },
  "duration": "<duration>"
}
