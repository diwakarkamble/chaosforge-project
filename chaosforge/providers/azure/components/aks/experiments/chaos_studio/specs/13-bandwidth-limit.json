{
  "kind": "NetworkChaos",
  "action": "bandwidth",
  "mode": "one",
  "selector": {
    "namespaces": [
      "<target-namespace>"
    ],
    "labelSelectors": {
      "app": "<app-label>"
    }
  },
  "bandwidth": {
    "rate": "1mbps",
    "limit": 20000,
    "buffer": 10000
  },
  "duration": "<duration>"
}
