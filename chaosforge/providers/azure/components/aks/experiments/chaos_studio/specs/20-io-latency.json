{
  "kind": "IOChaos",
  "action": "latency",
  "mode": "one",
  "selector": {
    "namespaces": [
      "<target-namespace>"
    ],
    "labelSelectors": {
      "app": "<app-label>"
    }
  },
  "volumePath": "/data",
  "path": "*",
  "delay": "100ms",
  "percent": 50,
  "duration": "<duration>"
}
