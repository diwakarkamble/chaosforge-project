{
    "service": "apigateway",
    "display_name": "Amazon API Gateway",

    "experiments": [

        {
            "id": "apigateway-stage-throttling",

            "name": "Stage Throttling Modification",

            "json": "apigateway-stage-throttling-chaos.json",

            "iam": {

                "read": [

                    "apigateway:GET"

                ],

                "modify": [

                    "apigateway:PATCH"

                ]

            },

            "inputs": [

                {
                    "name": "rest_api_id",

                    "label": "API Gateway",

                    "type": "aws_resource",

                    "resource_type": "apigateway",

                    "return": "id",

                    "required": true
                },

                {
                    "name": "stage_name",

                    "label": "Stage",

                    "type": "aws_resource",

                    "resource_type": "apigateway-stage",

                    "parent": "rest_api_id",

                    "return": "stageName",

                    "required": true
                },

                {
                    "name": "throttle_rate",

                    "label": "Target Rate Limit",

                    "default": "10"
                },

                {
                    "name": "throttle_burst",

                    "label": "Target Burst Limit",

                    "default": "20"
                },

                {
                    "name": "aws_region",

                    "label": "AWS Region",

                    "default": "eu-central-1"
                },

                {
                    "name": "wait_seconds",

                    "label": "Wait Duration (seconds)",

                    "default": "300"
                }

            ]

        },
