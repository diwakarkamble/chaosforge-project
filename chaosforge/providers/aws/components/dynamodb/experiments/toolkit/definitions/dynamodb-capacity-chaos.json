{
  "version": "1.0.0",
  "title": "AWS DynamoDB Capacity Chaos Test",
  "description": "Temporarily reduce DynamoDB provisioned capacity and restore the original values.",
  "configuration": {
    "table_name": null,
    "region": null,
    "target_rcu": null,
    "target_wcu": null,
    "wait_seconds": "300"
  },
  "method": [
    {
      "name": "capture-current-capacity",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.dynamodb.experiments.toolkit.actions.dynamodb_capacity_actions",
        "func": "capture_current_capacity",
        "arguments": {
          "table_name": "${table_name}",
          "region": "${region}"
        }
      }
    },
    {
      "name": "update-capacity",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.dynamodb.experiments.toolkit.actions.dynamodb_capacity_actions",
        "func": "update_capacity",
        "arguments": {
          "table_name": "${table_name}",
          "region": "${region}",
          "target_rcu": "${target_rcu}",
          "target_wcu": "${target_wcu}"
        }
      }
    },
    {
      "name": "wait",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.dynamodb.experiments.toolkit.actions.dynamodb_capacity_actions",
        "func": "wait_for_duration",
        "arguments": {
          "wait_seconds": "${wait_seconds}"
        }
      }
    }
  ],
  "rollbacks": [
    {
      "name": "restore-capacity",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.dynamodb.experiments.toolkit.actions.dynamodb_capacity_actions",
        "func": "restore_capacity",
        "arguments": {
          "table_name": "${table_name}",
          "region": "${region}"
        }
      }
    }
  ]
}
