{
  "version": "1.0.0",
  "title": "AWS DynamoDB Stream Chaos Test",
  "description": "Temporarily disable DynamoDB Streams and restore the original configuration.",

  "configuration": {
    "table_name": null,
    "region": null,
    "wait_seconds": "300"
  },

  "method": [
    {
      "name": "capture-current-stream",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.dynamodb.experiments.toolkit.actions.dynamodb_stream_actions",
        "func": "capture_current_stream",
        "arguments": {
          "table_name": "${table_name}",
          "region": "${region}"
        }
      }
    },
    {
      "name": "disable-stream",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.dynamodb.experiments.toolkit.actions.dynamodb_stream_actions",
        "func": "disable_stream",
        "arguments": {
          "table_name": "${table_name}",
          "region": "${region}"
        }
      }
    },
    {
      "name": "wait",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.dynamodb.experiments.toolkit.actions.dynamodb_stream_actions",
        "func": "wait_for_duration",
        "arguments": {
          "wait_seconds": "${wait_seconds}"
        }
      }
    }
  ],

  "rollbacks": [
    {
      "name": "restore-stream",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.dynamodb.experiments.toolkit.actions.dynamodb_stream_actions",
        "func": "restore_stream",
        "arguments": {
          "table_name": "${table_name}",
          "region": "${region}"
        }
      }
    }
  ]
}
