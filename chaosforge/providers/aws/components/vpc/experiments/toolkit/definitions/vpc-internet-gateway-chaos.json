{
    "version": "1.0.0",
    "title": "Internet Gateway Isolation",
    "description": "Temporarily detach an Internet Gateway from a VPC and restore it.",

    "configuration": {
        "internet_gateway_id": null,
        "aws_region": null,
        "wait_seconds": null
    },

    "method": [
        {
            "name": "Capture and Detach Internet Gateway",
            "type": "action",
            "provider": {
                "type": "python",
                "module": "chaosforge.providers.aws.components.vpc.experiments.toolkit.actions.vpc_internet_gateway_actions",
                "func": "capture_and_detach_igw",
                "arguments": {
                    "internet_gateway_id": "${internet_gateway_id}",
                    "region": "${aws_region}"
                }
            }
        },
        {
            "name": "Wait",
            "type": "action",
            "provider": {
                "type": "python",
                "module": "chaosforge.providers.aws.common_actions",
                "func": "wait_for_duration",
                "arguments": {
                    "wait_seconds": "${wait_seconds}"
                }
            }
        },
        {
            "name": "Rollback",
            "type": "action",
            "provider": {
                "type": "python",
                "module": "chaosforge.providers.aws.components.vpc.experiments.toolkit.actions.vpc_internet_gateway_actions",
                "func": "rollback_igw"
            }
        }
    ]
}
