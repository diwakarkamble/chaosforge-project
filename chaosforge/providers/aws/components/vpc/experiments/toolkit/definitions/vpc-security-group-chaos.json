{
    "version": "1.0.0",
    "title": "VPC Security Group Chaos",
    "description": "Temporarily revoke a Security Group rule and restore it.",

    "configuration": {
        "security_group_id": null,
        "aws_region": null,
        "selected_rule": null,
        "rule_index": null,
        "wait_seconds": null
    },

    "method": [
        {
            "name": "Capture and Remove Rule",
            "type": "action",
            "provider": {
                "type": "python",
                "module": "chaosforge.providers.aws.components.vpc.experiments.toolkit.actions.vpc_security_group_actions",
                "func": "capture_and_remove_rule",
                "arguments": {
                    "security_group_id": "${security_group_id}",
                    "region": "${aws_region}",
                    "selected_rule": "${selected_rule}"
                }
            }
        },
        {
            "name": "Wait",
            "type": "action",
            "provider": {
                "type": "python",
                "module": "chaosforge.providers.aws.common_actions",
                "func": "wait_for_duration",
                "arguments": {
                    "wait_seconds": "${wait_seconds}"
                }
            }
        },
        {
            "name": "Rollback",
            "type": "action",
            "provider": {
                "type": "python",
                "module": "chaosforge.providers.aws.components.vpc.experiments.toolkit.actions.vpc_security_group_actions",
                "func": "rollback_security_group"
            }
        }
    ]
}
