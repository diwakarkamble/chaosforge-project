{
  "version": "1.0.0",
  "title": "Amazon EC2 EBS Volume Attachment to Auto Scaling Group Instance",
  "description": "Selects a running EC2 instance from an Auto Scaling Group, attaches an available EBS volume, waits for the configured duration, and restores the original attachment during rollback.",

  "configuration": {
    "aws_region": null,
    "autoscaling_group": null,
    "volume_id": null,
    "device_name": "/dev/sdf",
    "wait_seconds": 30
  },

  "method": [
    {
      "name": "attach-asg-ebs-volume",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.ec2.experiments.toolkit.actions.ec2_ebs_actions",
        "func": "attach_ebs_volume_to_asg_instance",
        "arguments": {
          "autoscaling_group": "${autoscaling_group}",
          "volume_id": "${volume_id}",
          "device_name": "${device_name}",
          "aws_region": "${aws_region}"
        }
      }
    },
    {
      "name": "wait",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.ec2.experiments.toolkit.actions.ec2_common",
        "func": "wait_for_duration",
        "arguments": {
          "wait_seconds": "${wait_seconds}"
        }
      }
    }
  ],

  "rollbacks": [
    {
      "name": "restore-asg-ebs-attachment",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.ec2.experiments.toolkit.actions.ec2_ebs_actions",
        "func": "restore_asg_attached_ebs_volume",
        "arguments": {
          "aws_region": "${aws_region}",
          "wait_seconds": "${wait_seconds}"
        }
      }
    }
  ]
}
