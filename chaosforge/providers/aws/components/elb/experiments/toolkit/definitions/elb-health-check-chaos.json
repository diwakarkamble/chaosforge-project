{
  "version": "1.0.0",
  "title": "Elastic Load Balancing Health Check Chaos",
  "description": "Temporarily changes the health check configuration of a selected ELB target group and restores the original configuration during rollback.",
  "configuration": {
    "aws_region": null,
    "target_group": null,
    "health_check_enabled": null
  },
  "method": [
    {
      "name": "modify-elb-health-check",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.elb.experiments.toolkit.actions.elb_health_check_actions",
        "func": "modify_health_check",
        "arguments": {
          "target_group_arn": "${target_group}",
          "health_check_enabled": "${health_check_enabled}",
          "aws_region": "${aws_region}"
        }
      }
    }
  ],
  "rollbacks": [
    {
      "name": "restore-elb-health-check",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.elb.experiments.toolkit.actions.elb_health_check_actions",
        "func": "restore_health_check",
        "arguments": {
          "aws_region": "${aws_region}"
        }
      }
    }
  ]
}
