{
  "version": "1.0.0",
  "title": "Elastic Load Balancing Load Balancer Attribute Chaos",
  "description": "Temporarily modifies a selected ELB load balancer attribute and restores the original value during rollback.",
  "configuration": {
    "aws_region": null,
    "load_balancer": null,
    "attribute_key": null,
    "attribute_value": null
  },
  "method": [
    {
      "name": "modify-elb-load-balancer-attribute",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.elb.experiments.toolkit.actions.elb_load_balancer_actions",
        "func": "modify_load_balancer_attribute",
        "arguments": {
          "load_balancer_arn": "${load_balancer}",
          "attribute_key": "${attribute_key}",
          "attribute_value": "${attribute_value}",
          "aws_region": "${aws_region}"
        }
      }
    }
  ],
  "rollbacks": [
    {
      "name": "restore-elb-load-balancer-attribute",
      "type": "action",
      "provider": {
        "type": "python",
        "module": "chaosforge.providers.aws.components.elb.experiments.toolkit.actions.elb_load_balancer_actions",
        "func": "restore_load_balancer_attribute",
        "arguments": {
          "aws_region": "${aws_region}"
        }
      }
    }
  ]
}
