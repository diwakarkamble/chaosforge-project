{
  "version": "1.0.0",
  "title": "AWS Lambda Concurrency Chaos Test",
  "description": "Temporarily reduce Lambda reserved concurrency and restore the original value.",

  "configuration": {
    "lambda_name": null,
    "aws_region": null,
    "target_concurrency": null,
    "wait_seconds": "300"
  },

  "method": [
    {
      "name": "capture-current-concurrency",
      "type": "action",
      "provider": {
        "type": "python",
    "module": "chaosforge.providers.aws.components.lambda.experiments.toolkit.actions.lambda_concurrency_actions",
        "func": "capture_current_concurrency",
        "arguments": {
          "function_name": "${lambda_name}",
          "region": "${aws_region}"
        }
      }
    },
    {
      "name": "update-concurrency",
      "type": "action",
      "provider": {
        "type": "python",
    "module": "chaosforge.providers.aws.components.lambda.experiments.toolkit.actions.lambda_concurrency_actions",
        "func": "update_concurrency",
        "arguments": {
          "function_name": "${lambda_name}",
          "concurrency_value": "${target_concurrency}",
          "region": "${aws_region}"
        }
      }
    },
    {
      "name": "wait",
      "type": "action",
      "provider": {
        "type": "python",
    "module": "chaosforge.providers.aws.components.lambda.experiments.toolkit.actions.lambda_concurrency_actions",
        "func": "wait_for_duration",
        "arguments": {
          "wait_seconds": "${wait_seconds}"
        }
      }
    }
  ],

  "rollbacks": [
    {
      "name": "restore-original-concurrency",
      "type": "action",
      "provider": {
        "type": "python",
    "module": "chaosforge.providers.aws.components.lambda.experiments.toolkit.actions.lambda_concurrency_actions",
        "func": "restore_concurrency",
        "arguments": {
          "function_name": "${lambda_name}",
          "region": "${aws_region}"
        }
      }
    }
  ]
}
